name: Compilar LaTeX a PDF

on:
  push:
    branches: [ "main" ]

jobs:
  build_latex:
    runs-on: ubuntu-latest
    steps:
      - name: Descargar codigo
        uses: actions/checkout@v4

      - name: Compilar LaTeX
        uses: xu-cheng/latex-action@v3
        with:
          root_file: main.tex

      - name: Guardar PDF
        uses: actions/upload-artifact@v4
        with:
          name: TP-Algo2-PDF
          path: main.pdf
